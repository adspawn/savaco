  (text "1. モジュール（ESP32-C3 SuperMini / E220-EV2、ソケット差し込み）"
    (at 19.05 39.37 0)
    (effects
      (font
        (size 2 2) bold)
      (justify left bottom))
    (uuid "f900d339-95d3-5332-8abb-b8e6b18223bb"))
  (rectangle
