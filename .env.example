# サバゲー進行システム 環境設定
# このファイルを .env にコピーして使用してください

# サーバーポート番号
PORT=3000

# UNIT-C6L (Meshtastic) USB シリアルポート
# Windows: デバイスマネージャーで UNIT-C6L の COM を確認 (例: COM5)
#   ※ CH340 など別デバイスの COM と取り違えないこと
# Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0 など
SERIAL_PORT=COM5

# LoRa 送信ノード -> ポジション (JSON)
# キーは Meshtastic の短縮ノードID (末尾4桁の16進数、大文字小文字区別なし)
# 現在の5台構成: Aフラッグ=D0E4, Bフラッグ=D528, Cフラッグ=CB80, Dフラッグ=C414, Eフラッグ=CCCC
LORA_NODE_MAP={"D0E4":"A","D528":"B","CB80":"C","C414":"D","CCCC":"E"}

# 本文が BUTTON_ON detected のときのデフォルトポジション
LORA_DEFAULT_POSITION=A

# 短押し/長押しの判定ウィンドウ (ms)
# 1回目のパルス受信後、この時間内に2回目が届けば「長押し」、届かなければ「短押し」
# ESP32側はパルスを約3秒間隔で2回送るため、4500ms程度を推奨
LORA_LONG_PRESS_WINDOW_MS=4500

# 判定確定後、同ポジションのパルスを無視するロックアウト時間 (ms)
# Detection Sensorの遅延二重発報(こだま)による誤検知を防ぐ
LORA_PULSE_LOCKOUT_MS=2500

# 実行環境
# development: 開発モード（Meshtastic通信なし、ブラウザのデバッグ信号のみで動作確認）
# production: 本番モード（Meshtastic通信あり）
NODE_ENV=development

# 予約カレンダーの取得 (npm run reservations)
# AI 判定は Pro プランでログイン済みの Claude Code CLI (claude -p) を使います (API キー不要)
# 判定に使うモデル (sonnet / opus / haiku など)
RESERVATION_CLAUDE_MODEL=sonnet
# claude コマンドのパス (PATH に無い場合だけ指定)
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
# 通常実行で AI に送る範囲 (今日から何日前以降の予定か)
RESERVATION_LOOKBACK_DAYS=30
# 1回の実行で claude を呼ぶ上限 (1回 = 最大100種類の予定)
RESERVATION_MAX_CALLS=30
